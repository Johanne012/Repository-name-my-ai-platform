# =============================
# AgenticAI — environment vars
# Copy to .env and fill values
# =============================

# Required for database
DATABASE_URL=mysql://user:password@localhost:3306/agentic_ai

# Session / JWT signing secret (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Manus / OAuth (optional for local stub; required in Manus runtime)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# LLM providers (multi-provider adaptive fallback)
# Add any combination. The system will automatically rank & fallback.
# ---------------------------------------------------------------------------

# Legacy Manus forge (still supported)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google Gemini (recommended primary)
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# Groq (very fast)
GROQ_API_KEY=

# OpenRouter (many free models behind one key)
OPENROUTER_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=

# Cerebras
CEREBRAS_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# GitHub Models (use a classic PAT with models scope)
GITHUB_TOKEN=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional tuning
# LLM_TIMEOUT_MS=45000
# LLM_MAX_RETRIES=1
# Comma-separated preferred order (overrides adaptive ranking partially)
# LLM_PREFERRED_ORDER=gemini,groq,openrouter,nvidia

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Runtime
NODE_ENV=development
