# =============================
# AgenticAI — environment vars
# Copy to .env and fill values
# =============================

# Required for database
DATABASE_URL=mysql://user:password@localhost:3306/agentic_ai

# Session / JWT signing secret (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Manus / OAuth (optional for local stub; required in Manus runtime)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Built-in LLM forge (Manus)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Runtime
NODE_ENV=development
